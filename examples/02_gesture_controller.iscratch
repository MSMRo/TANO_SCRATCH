{
  "name": "02_Gestos_y_Tonos",
  "version": "1.0",
  "description": "El objeto Scratch reacciona a los gestos ópticos (ARRIBA, ABAJO) captados por el sensor APDS9960 y reproduce tonos de audio",
  "xml": "<xml xmlns=\"https://developers.google.com/blockly/xml\"><block type=\"scratch_when_flag\" x=\"50\" y=\"50\"><statement name=\"STACK\"><block type=\"scratch_say\"><value name=\"TEXT\"><shadow type=\"text\"><field name=\"TEXT\">Haz gestos sobre el sensor APDS9960</field></shadow></value></block></statement></block><block type=\"nano33_when_gesture\" x=\"50\" y=\"160\"><field name=\"GESTURE\">UP</field><statement name=\"DO\"><block type=\"scratch_say_for_secs\"><value name=\"TEXT\"><shadow type=\"text\"><field name=\"TEXT\">¡Gesto ARRIBA detectado!</field></shadow></value><value name=\"SECS\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value><next><block type=\"scratch_play_sound\"><value name=\"FREQ\"><shadow type=\"math_number\"><field name=\"NUM\">880</field></shadow></value><value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value></block></next></block></statement></block><block type=\"nano33_when_gesture\" x=\"50\" y=\"320\"><field name=\"GESTURE\">DOWN</field><statement name=\"DO\"><block type=\"scratch_say_for_secs\"><value name=\"TEXT\"><shadow type=\"text\"><field name=\"TEXT\">¡Gesto ABAJO detectado!</field></shadow></value><value name=\"SECS\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value><next><block type=\"scratch_play_sound\"><value name=\"FREQ\"><shadow type=\"math_number\"><field name=\"NUM\">330</field></shadow></value><value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value></block></next></block></statement></block></xml>"
}
