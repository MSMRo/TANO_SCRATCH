  "description": "Alarma inteligente que combina visión por computadora con Teachable Machine y actuadores del Arduino Nano 33 BLE Sense",
  "xml": "<xml xmlns=\"https://developers.google.com/blockly/xml\"><block type=\"scratch_when_flag\" x=\"50\" y=\"50\"><statement name=\"STACK\"><block type=\"scratch_say_for_secs\"><value name=\"TEXT\"><shadow type=\"text\"><field name=\"TEXT\">Iniciando Sistema de Vigilancia IA...</field></shadow></value><value name=\"SECS\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value><next><block type=\"tm_start_webcam\"><next><block type=\"scratch_say\"><value name=\"TEXT\"><shadow type=\"text\"><field name=\"TEXT\">Cámara y Clasificador Activos</field></shadow></value></block></next></block></next></block></statement></block><block type=\"tm_when_class\" x=\"50\" y=\"200\"><value name=\"CLASS_NAME\"><shadow type=\"text\"><field name=\"TEXT\">Peligro</field></shadow></value><statement name=\"DO\"><block type=\"nano33_set_led\"><field name=\"STATE\">1</field><next><block type=\"nano33_set_rgb\"><value name=\"R\"><shadow type=\"math_number\"><field name=\"NUM\">255</field></shadow></value><value name=\"G\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"scratch_play_sound\"><value name=\"FREQ\"><shadow type=\"math_number\"><field name=\"NUM\">900</field></shadow></value><value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.4</field></shadow></value><next><block type=\"scratch_say_for_secs\"><value name=\"TEXT\"><shadow type=\"text\"><field name=\"TEXT\">¡ALERTA! Objeto no autorizado</field></shadow></value><value name=\"SECS\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value></block></next></block></next></block></next></block></statement></block></xml>"
